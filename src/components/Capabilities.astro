---
import { capabilities, ui, t, type Lang } from '../data/content';
import { splitHeading } from '../data/format';
interface Props { lang: Lang }
const { lang } = Astro.props;
const icons: Record<string, string> = {
  software: '<path d="M8 6 2 12l6 6M16 6l6 6-6 6M14 4l-4 16"/>',
  devops: '<rect x="3" y="3" width="18" height="7" rx="2"/><rect x="3" y="14" width="18" height="7" rx="2"/><path d="M7 6.5h.01M7 17.5h.01"/>',
  ai: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/><circle cx="12" cy="12" r="3.5"/>',
};
---
<section class="section caps" id="capabilities">
  <div class="wrap">
    <span class="kicker" data-reveal>{t(ui.capsKicker, lang)}</span>
    <h2 class="display h2" data-reveal-group set:html={splitHeading(t(ui.capsTitle, lang))} />

    <div class="cards">
      {capabilities.map((c, i) => (
        <article class="card" data-reveal data-spotlight style={`--d:${i * 120}`}>
          <div class="icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[c.key]} />
          </div>
          <h3 class="display">{t(c.title, lang)}</h3>
          <p class="blurb">{t(c.blurb, lang)}</p>
          <ul>
            {c.items.map((it) => <li>{it}</li>)}
          </ul>
          <span class="cn mono" aria-hidden="true">0{i + 1} / 0{capabilities.length}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: clamp(48px, 6vw, 80px); }
  .card {
    position: relative; padding: 32px 28px 64px; border-radius: 22px; overflow: hidden;
    border: 1px solid var(--line); background: var(--ink-2);
    transition: border-color 0.4s, transform 0.6s var(--ease);
  }
  .card::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.4s;
    background: radial-gradient(420px circle at var(--sx, 50%) var(--sy, 50%), rgba(var(--accent-rgb), 0.13), transparent 45%);
  }
  .card::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
    background: conic-gradient(from var(--angle), transparent 0 60%, var(--accent) 75%, var(--accent-2) 85%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    opacity: 0; transition: opacity 0.5s; animation: spin 4s linear infinite;
  }
  .card:hover::after { opacity: 1; }
  @keyframes spin { to { --angle: 360deg; } }
  .card:hover { border-color: var(--line-2); transform: translateY(-6px); }
  .card li { transition: color 0.3s, padding-left 0.4s var(--ease); }
  .card li:hover { color: var(--bone); padding-left: 6px; }
  .card:hover::before { opacity: 1; }
  .icon { transition: transform 0.6s var(--ease-back), background 0.4s, color 0.4s, border-color 0.4s; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; border: 1px solid var(--line-2); color: var(--accent); }
  .card h3 { margin-top: 28px; font-size: clamp(32px, 3vw, 44px); line-height: 1; }
  .blurb { margin-top: 12px; color: var(--mute); font-size: 15px; }
  .card ul { margin-top: 24px; }
  .card li { padding: 10px 0; border-top: 1px solid var(--line); font-size: 14.5px; color: var(--bone-2); }
  .cn { position: absolute; right: 24px; bottom: 22px; font-size: 11px; color: var(--mute); }

    .card:hover .icon { transform: rotate(-12deg) scale(1.1); background: var(--grad); color: var(--ink); border-color: transparent; }
  @media (max-width: 960px) { .cards { grid-template-columns: 1fr; } }
</style>
