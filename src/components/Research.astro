---
import '../styles/diagrams.css';
import { research, t, type Lang } from '../data/content';
import { splitHeading } from '../data/format';
import Keystroke from './diagrams/Keystroke.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="section research" id="research">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    <span class="kicker" data-reveal>{t(research.kicker, lang)}</span>
    <h2 class="display h2" data-reveal-group set:html={splitHeading(t(research.title, lang))} />

    <div class="thesis" data-reveal>
      <span class="status mono"><span class="dot" aria-hidden="true"></span>{t(research.status, lang)}</span>
      <p class="title display">"{research.thesis}"</p>
      <p class="where">{t(research.where, lang)}</p>
    </div>

    <div class="grid">
      <div class="left">
        <p class="lead" data-reveal>{t(research.lead, lang)}</p>

        <h3 class="sub mono" data-reveal>{t(research.findingsTitle, lang)}</h3>
        <ol class="findings">
          {research.findings.map((f, i) => (
            <li data-reveal style={`--d:${i * 80}`}>
              <span class="fn mono">0{i + 1}</span>
              <p>{t(f, lang)}</p>
            </li>
          ))}
        </ol>

        <p class="method mono" data-reveal>{research.method}</p>
        <p class="next" data-reveal>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg>
          {t(research.next, lang)}
        </p>
      </div>

      <div class="right">
        <div class="viz" data-clip data-tilt>
          <Keystroke />
        </div>

        <h3 class="sub mono" data-reveal>{t(research.pubsTitle, lang)}</h3>
        <ul class="pubs">
          {research.pubs.map((p, i) => (
            <li data-reveal style={`--d:${i * 90}`}>
              <div class="pub-top mono">
                <span class:list={['yr', { prep: i === 0 }]}>{t(p.year, lang)}</span>
                <span class="note">{t(p.note, lang)}</span>
              </div>
              <p class="pub-title">{p.title}</p>
              <p class="venue">{research.authors} · <em>{p.venue}</em></p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .research { overflow: hidden; }
  .glow {
    position: absolute; left: -20%; top: 20%; width: 900px; height: 900px; pointer-events: none;
    background: radial-gradient(circle, rgba(var(--accent-2-rgb), 0.09), transparent 60%); filter: blur(20px);
  }
  .thesis { margin-top: 40px; padding: 28px 0 34px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .status {
    display: inline-flex; align-items: center; gap: 10px; height: 30px; padding: 0 14px; border-radius: 999px;
    border: 1px solid rgba(var(--accent-rgb), 0.4); background: rgba(var(--accent-rgb), 0.08); color: var(--bone); font-size: 12px;
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .thesis .title { margin-top: 20px; font-size: clamp(26px, 3.2vw, 46px); line-height: 1.08; letter-spacing: -0.03em; max-width: 26ch; }
  .where { margin-top: 14px; color: var(--mute); font-size: 14.5px; }

  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(40px, 6vw, 96px); margin-top: clamp(40px, 5vw, 64px); align-items: start; }
  .sub { margin: 40px 0 14px; font-size: 11px; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mute); }
  .findings { margin: 0; padding: 0; list-style: none; }
  .findings li { display: grid; grid-template-columns: 40px 1fr; gap: 10px; padding: 16px 0; border-top: 1px solid var(--line); }
  .fn { font-size: 12px; color: var(--accent-2); padding-top: 3px; }
  .findings p { color: var(--bone-2); font-size: 15.5px; line-height: 1.55; }
  .method { margin-top: 28px; font-size: 12px; color: var(--mute); line-height: 1.7; }
  .next { display: flex; gap: 12px; align-items: baseline; margin-top: 18px; font-size: 15.5px; color: var(--bone); }
  .next svg { flex: none; color: var(--accent-2); transform: translateY(2px); }

  .viz {
    padding: clamp(14px, 2vw, 24px); border: 1px solid var(--line-2); border-radius: 20px;
    background: linear-gradient(180deg, var(--ink-2), var(--ink)); box-shadow: 0 40px 120px -40px rgba(0, 0, 0, 0.8);
    transition: transform 0.8s var(--ease);
  }
  .pubs li { padding: 18px 0; border-top: 1px solid var(--line); transition: padding-left 0.5s var(--ease); }
  .pubs li:hover { padding-left: 8px; }
  .pub-top { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; font-size: 11px; }
  .yr { color: var(--accent-2); letter-spacing: 0.06em; }
  .yr.prep { color: var(--accent); }
  .note { color: var(--mute); text-transform: uppercase; letter-spacing: 0.1em; font-size: 10px; }
  .pub-title { margin-top: 8px; font-family: var(--display); font-size: 19px; line-height: 1.25; letter-spacing: -0.02em; }
  .venue { margin-top: 6px; font-size: 13px; color: var(--mute); }
  .venue em { font-style: normal; color: var(--bone-2); }

  @media (max-width: 960px) { .grid { grid-template-columns: 1fr; } }
</style>
