---
// Idara — every HR module hangs off one employee record. A sweep lights them in turn.
const modules = ['staff', 'assignments', 'careers', 'leave', 'absences', 'quotas', 'discipline', 'evaluations'];
const cx = 260, cy = 196, rx = 186, ry = 132;
const nodes = modules.map((m, i) => {
  const a = (i / modules.length) * Math.PI * 2 - Math.PI / 2;
  return { m, i, x: cx + Math.cos(a) * rx, y: cy + Math.sin(a) * ry };
});
const W = 96, H = 30;
---
<svg class="dg orbit" viewBox="0 0 520 400" role="img" aria-label="Idara: eight HR modules (staff, assignments, careers, leave, absences, quotas, discipline, evaluations) around one employee record, producing PDF attestations in French and Arabic">
  <defs>
    <linearGradient id="o-sweep" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="var(--accent)" stop-opacity="0" />
      <stop offset="1" stop-color="var(--accent)" stop-opacity="0.35" />
    </linearGradient>
  </defs>

  <ellipse cx={cx} cy={cy} rx={rx} ry={ry} class="frame" />
  <ellipse cx={cx} cy={cy} rx={rx * 0.55} ry={ry * 0.55} class="frame faint" />

  <!-- radar sweep -->
  <g class="sweep">
    <path d={`M${cx} ${cy} L${cx + rx + 30} ${cy - 46} A ${rx + 30} ${ry + 30} 0 0 1 ${cx + rx + 30} ${cy + 2} Z`} fill="url(#o-sweep)" />
  </g>

  {nodes.map((n) => (
    <path id={`o-l${n.i}`} d={`M${cx} ${cy} L${n.x} ${n.y}`} class="spoke" />
  ))}
  {nodes.map((n) => (
    <circle r="2.6" class="packet">
      <animateMotion dur="2.4s" begin={`${n.i * 0.3}s`} repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1"><mpath href={`#o-l${n.i}`} /></animateMotion>
    </circle>
  ))}

  {nodes.map((n) => (
    <g class="node mod" transform={`translate(${n.x - W / 2} ${n.y - H / 2})`} style={`--i:${n.i}`}>
      <rect width={W} height={H} rx="15" />
      <text x={W / 2} y="19.5" text-anchor="middle" class="role">{n.m}</text>
    </g>
  ))}

  <!-- core record -->
  <g transform={`translate(${cx} ${cy})`}>
    <circle r="52" class="ring r1" />
    <circle r="40" class="core-o" />
    <circle cy="-9" r="9" class="actor-i" />
    <path d="M-15 16a15 12 0 0 1 30 0" class="actor-i" />
    <text y="68" text-anchor="middle" class="lbl">EMPLOYEE RECORD</text>
  </g>

  <!-- output -->
  <g transform="translate(404 340)">
    <rect width="104" height="40" rx="10" class="node-r" />
    <rect x="12" y="9" width="16" height="22" rx="2" class="pdf" />
    <text x="36" y="18" class="lbl ok">PDF</text>
    <text x="36" y="31" class="role sm">FR · AR</text>
  </g>
</svg>

<style>
  .orbit .frame.faint { stroke-opacity: 0.5; }
  .orbit .sweep { transform-box: view-box; transform-origin: 260px 196px; animation: o-spin 6s linear infinite; }
  .orbit .spoke { fill: none; stroke: var(--line-2); stroke-dasharray: 2 5; }
  .orbit .mod rect { transition: none; animation: o-lit 6s linear infinite; animation-delay: calc(var(--i) * 0.75s - 1.74s); }
  .orbit .core-o { fill: var(--ink-3); stroke: rgba(var(--accent-rgb), 0.6); }
  .orbit .pdf { fill: none; stroke: var(--accent-2); stroke-width: 1.3; }
  .orbit .role.sm { font-size: 10px; }
  @keyframes o-spin { to { transform: rotate(360deg); } }
  @keyframes o-lit {
    0%, 100% { stroke: var(--line-2); fill: var(--ink-3); }
    6% { stroke: var(--accent); fill: rgba(var(--accent-rgb), 0.18); }
    22% { stroke: var(--line-2); fill: var(--ink-3); }
  }
</style>
