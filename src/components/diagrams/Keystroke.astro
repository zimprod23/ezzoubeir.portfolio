---
// CLCA in one picture: typing rhythm drifts session to session, the adaptive model follows it.
const keys = ['r', 'a', 'b', 'a', 't', ' ', '2', '0', '2', '6'];
// Deterministic pseudo-random so the build is stable
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const bars = Array.from({ length: 26 }, () => 0.25 + rnd() * 0.75);
const X0 = 40, X1 = 480, base = 256, amp = 120;
const pts = (shift: number, wobble: number) =>
  bars
    .map((b, i) => {
      const x = X0 + (i / (bars.length - 1)) * (X1 - X0);
      const y = base - (b * 0.8 + Math.sin(i * 0.9 + shift) * wobble) * amp;
      return `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
    })
    .join(' ');
const enrolled = pts(0, 0.05);
const drifts = [pts(0, 0.05), pts(1.2, 0.18), pts(2.4, 0.26), pts(1.2, 0.18), pts(0, 0.05)];
---
<svg class="dg ks" viewBox="0 0 520 360" role="img" aria-label="Keystroke dynamics: a typing rhythm drifts across sessions while the adaptive authentication model follows it and keeps recognising the user">
  <defs>
    <linearGradient id="ks-g" x1="0" x2="1">
      <stop offset="0" stop-color="var(--accent)" />
      <stop offset="1" stop-color="var(--accent-2)" />
    </linearGradient>
  </defs>
  <text x="24" y="30" class="lbl">KEYSTROKE DYNAMICS · CLCA</text>
  <text x="496" y="30" text-anchor="end" class="lbl ok">ON-DEVICE</text>

  <!-- keys being typed -->
  {keys.map((k, i) => (
    <g transform={`translate(${24 + i * 47.5} 48)`} class="key" style={`--i:${i}`}>
      <rect width="40" height="40" rx="9" />
      <text x="20" y="26" text-anchor="middle" class="role">{k === ' ' ? '␣' : k}</text>
    </g>
  ))}

  <!-- hold-time bars -->
  {bars.map((b, i) => {
    const x = X0 + (i / (bars.length - 1)) * (X1 - X0) - 3;
    return <rect x={x} y={base - b * amp} width="6" height={b * amp} rx="3" class="bar" style={`--i:${i}`} />;
  })}
  <line x1="24" y1={base} x2="496" y2={base} class="axis" />

  <!-- enrolled profile vs. today's typing -->
  <path d={enrolled} class="enrolled" />
  <path d={drifts[0]} class="live">
    <animate attributeName="d" dur="9s" repeatCount="indefinite" values={drifts.join(';')} calcMode="spline" keySplines="0.4 0 0.2 1;0.4 0 0.2 1;0.4 0 0.2 1;0.4 0 0.2 1" />
  </path>

  <g transform="translate(24 284)">
    <text y="10" class="lbl">ENROLLED</text>
    <line x1="74" y1="6" x2="104" y2="6" class="enrolled" />
    <text x="120" y="10" class="lbl">TODAY</text>
    <line x1="164" y1="6" x2="194" y2="6" class="live" />
  </g>

  <!-- confidence -->
  <g transform="translate(24 310)">
    <rect width="472" height="34" rx="17" class="meter" />
    <rect x="4" y="4" height="26" rx="13" class="meter-fill" />
    <circle cx="22" cy="17" r="4" class="led ok" />
    <text x="34" y="21.5" class="role">still you</text>
    <text x="460" y="21.5" text-anchor="end" class="role mono-v">drift absorbed · no raw data kept</text>
  </g>
</svg>

<style>
  .ks .key rect { fill: var(--ink-3); stroke: var(--line-2); animation: ks-press 4s ease-out infinite; animation-delay: calc(var(--i) * 0.28s); }
  .ks .key text { font-size: 13px; }
  .ks .bar { fill: url(#ks-g); opacity: 0.22; transform-box: fill-box; transform-origin: bottom; animation: ks-bar 3.2s ease-in-out infinite; animation-delay: calc(var(--i) * -0.17s); }
  .ks .axis { stroke: var(--line-2); }
  .ks .enrolled { fill: none; stroke: var(--bone-2); stroke-opacity: 0.45; stroke-width: 1.4; stroke-dasharray: 4 5; }
  .ks .live { fill: none; stroke: url(#ks-g); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 6px rgba(var(--accent-rgb), 0.6)); }
  .ks line.live { stroke: var(--accent-2); filter: none; }
  .ks .meter { fill: var(--ink-2); stroke: var(--line-2); }
  .ks .meter-fill { fill: rgba(var(--accent-2-rgb), 0.12); stroke: rgba(var(--accent-2-rgb), 0.35); width: 440px; animation: ks-meter 9s ease-in-out infinite; }
  .ks .mono-v { fill: var(--mute); font-size: 10.5px; }
  @keyframes ks-press {
    0%, 100% { fill: var(--ink-3); stroke: var(--line-2); transform: none; }
    4% { fill: rgba(var(--accent-rgb), 0.35); stroke: var(--accent); transform: translateY(2px); }
    14% { fill: var(--ink-3); stroke: var(--line-2); transform: none; }
  }
  @keyframes ks-bar { 50% { transform: scaleY(0.7); opacity: 0.4; } }
  @keyframes ks-meter { 0%, 100% { width: 440px; } 45% { width: 380px; } 60% { width: 430px; } }
</style>
