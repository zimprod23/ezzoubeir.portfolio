---
import { journey, t, type Lang } from '../data/content';
import { splitHeading } from '../data/format';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="section journey" id="journey">
  <div class="wrap grid">
    <div class="left">
      <span class="kicker" data-reveal>{t(journey.kicker, lang)}</span>
      <h2 class="display h2 sm" data-reveal-group set:html={splitHeading(t(journey.title, lang))} />
      <div class="certs" data-reveal style="--d:200">
        <h3 class="mono">{t(journey.certsTitle, lang)}</h3>
        <ul>{journey.certs.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>

    <ol class="timeline" data-timeline>
      <span class="rail" aria-hidden="true"><span data-rail></span></span>
      {journey.items.map((it, i) => (
        <li data-reveal style={`--d:${i * 60}`}>
          <span class="knot" aria-hidden="true"></span>
          <span class="when mono">{it.when}</span>
          <h3>{t(it.role, lang)}</h3>
          <p class="where">{t(it.where, lang)}</p>
          <p class="body">{t(it.body, lang)}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(48px, 7vw, 120px); }
  .left { position: sticky; top: 110px; align-self: start; }
  .certs { margin-top: 48px; padding: 24px; border: 1px solid var(--line); border-radius: 18px; background: var(--ink-2); }
  .certs h3 { font-size: 11px; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mute); }
  .certs li { padding: 10px 0; border-top: 1px solid var(--line); font-size: 14.5px; color: var(--bone-2); }
  .certs li:first-child { border-top: 0; }

  .timeline { position: relative; margin: 0; padding: 0 0 0 40px; list-style: none; }
  .rail { position: absolute; left: 6px; top: 8px; bottom: 8px; width: 1px; background: var(--line); }
  .rail span { position: absolute; inset: 0; background: linear-gradient(var(--accent), var(--accent-2) 85%, transparent); transform-origin: top; transform: scaleY(var(--p, 0)); }
  .timeline li { position: relative; padding: 0 0 48px; }
  .knot { position: absolute; left: -40px; top: 6px; width: 13px; height: 13px; border-radius: 50%; border: 1px solid var(--line-2); background: var(--ink); transition: background 0.4s, border-color 0.4s, box-shadow 0.4s; }
  .timeline li.in .knot { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 5px var(--accent-soft), 0 0 18px rgba(var(--accent-rgb), 0.6); }
  .when { font-size: 12px; color: var(--accent-2); letter-spacing: 0.06em; }
  .timeline h3 { margin-top: 8px; font-family: var(--display); font-weight: 500; letter-spacing: -0.03em; font-size: clamp(26px, 2.6vw, 34px); line-height: 1.1; }
  .where { margin-top: 6px; font-size: 14px; color: var(--bone-2); }
  .body { margin-top: 10px; font-size: 15px; color: var(--mute); max-width: 56ch; }

  @media (max-width: 960px) {
    .grid { grid-template-columns: 1fr; }
    .left { position: relative; top: 0; }
  }
</style>
