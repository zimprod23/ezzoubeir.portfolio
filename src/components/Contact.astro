---
import { contact, person, ui, t, type Lang } from '../data/content';
import { splitHeading } from '../data/format';
interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<section class="section contact" id="contact">
  <div class="orb" aria-hidden="true"></div>
  <div class="wrap">
    <span class="kicker" data-reveal>{t(contact.kicker, lang)}</span>
    <h2 class="display big" data-reveal-group set:html={splitHeading(t(contact.title, lang))} />
    <p class="lead" data-reveal style="--d:200">{t(contact.lead, lang)}</p>

    <div class="mail-row" data-reveal style="--d:300">
      <a class="mail display" href={`mailto:${person.email}`} data-cursor>
        <span class="mail-text">{person.email}</span>
        <span class="mail-line" aria-hidden="true"></span>
      </a>
      <button class="copy mono" data-magnetic data-copy={person.email} data-copied-label={t(contact.copied, lang)} data-cursor>
        {t(contact.copy, lang)}
      </button>
    </div>

    <ul class="socials" data-reveal style="--d:400">
      <li><a href={person.linkedin} target="_blank" rel="noopener" data-cursor data-magnetic>LinkedIn <span aria-hidden="true">↗</span></a></li>
      <li><a href={person.github} target="_blank" rel="noopener" data-cursor data-magnetic>GitHub <span aria-hidden="true">↗</span></a></li>
      <li><a href="https://lexiarchive.com" target="_blank" rel="noopener" data-cursor data-magnetic>Lexi <span aria-hidden="true">↗</span></a></li>
    </ul>
  </div>

  <div class="giant-wrap" aria-hidden="true">
    <div class="giant display" data-giant>{person.firstName}</div>
  </div>

  <footer class="wrap foot mono">
    <span>© {year} {person.firstName} {person.lastName}</span>
    <span>{t(ui.footer, lang)}</span>
    <span>{person.location}</span>
  </footer>
</section>

<style>
  .contact { overflow: hidden; padding-bottom: 32px; }
  .orb {
    position: absolute; left: 50%; bottom: -520px; width: 1100px; height: 1100px; margin-left: -550px; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.22), rgba(var(--accent-rgb), 0.04) 45%, transparent 65%);
    animation: breathe 8s ease-in-out infinite;
  }
  @keyframes breathe { 50% { transform: scale(1.08); opacity: 0.8; } }
  .big { font-size: clamp(48px, 9vw, 148px); margin-top: 24px; max-width: 14ch; }
  .lead { margin-top: 32px; }

  .mail-row { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 32px; margin-top: clamp(48px, 6vw, 80px); }
  .mail { position: relative; font-size: clamp(26px, 4.4vw, 64px); line-height: 1.1; word-break: break-all; }
  .mail-line { position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; background: var(--grad); transform: scaleX(0.15); transform-origin: left; transition: transform 0.8s var(--ease); }
  .mail:hover .mail-line { transform: scaleX(1); }
  .copy { height: 40px; padding: 0 18px; border: 1px solid var(--line-2); border-radius: 999px; font-size: 12px; color: var(--bone-2); transition: border-color 0.3s, color 0.3s; }
  .copy:hover { border-color: var(--bone); color: var(--bone); }
  .copy.done { border-color: var(--signal); color: var(--signal); }

  .socials { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 48px; }
  .socials a { display: inline-flex; align-items: center; gap: 8px; height: 48px; padding: 0 22px; border: 1px solid var(--line-2); border-radius: 999px; font-size: 15px; transition: background 0.3s, color 0.3s, border-color 0.3s; }
  .socials a:hover { background: var(--bone); color: var(--ink); border-color: var(--bone); }

  .giant-wrap { overflow: hidden; margin-top: clamp(64px, 8vw, 120px); }
  .giant {
    font-size: clamp(80px, 21vw, 340px); font-weight: 800; line-height: 0.8; letter-spacing: -0.06em; text-align: center;
    color: transparent; -webkit-text-stroke: 1px rgba(226, 232, 255, 0.18);
    background: var(--grad) 0 0 / var(--fill, 0%) 100% no-repeat; -webkit-background-clip: text; background-clip: text;
    transform: translateY(calc((1 - var(--fill-n, 0)) * 18%));
    padding-bottom: 0.04em;
  }
  .foot {
    position: relative; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px;
    margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--line);
    font-size: 11.5px; color: var(--mute);
  }
</style>
